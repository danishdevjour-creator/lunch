# ---- App ----
PORT=3000
# Public URL of this app (used in email links and payment return URLs)
BASE_URL=http://localhost:3000
ADMIN_PASSWORD=change-me

# ---- Email (SMTP) ----
# Gmail: turn on 2-Step Verification, then create an App Password and use it as SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Lunch Budget <your@gmail.com>"

# ---- JazzCash online checkout (optional) ----
# From your JazzCash merchant portal. Leave empty to only allow manual JazzCash transfers.
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
# sandbox or production
JAZZCASH_ENV=sandbox

# ---- Meezan Bank online gateway (optional) ----
# Credentials issued by Meezan Bank for their e-commerce payment gateway (IPG).
# Leave empty to only allow manual bank transfers.
MEEZAN_USERNAME=
MEEZAN_PASSWORD=
MEEZAN_API_BASE=https://acquiring.meezanbank.com/payment/rest
